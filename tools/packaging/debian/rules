#!/usr/bin/make -f
# SPDX-FileCopyrightText: 2026 Paul Woisard
# SPDX-License-Identifier: GPL-3.0-or-later
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
%:
	dh $@ --buildsystem=cmake

override_dh_auto_configure:
	dh_auto_configure -- -DCMAKE_BUILD_TYPE=Release -DGALLEON_SOURCE_TREE_PATHS=OFF -DBUILD_TESTING=ON -DGALLEON_WERROR=OFF

override_dh_auto_test:
	ctest --test-dir obj-* --output-on-failure

override_dh_auto_install:
	dh_auto_install
	sh tools/packaging/install-extras.sh . debian/galleoncore
	# The v0.1.0 source tarball has epoch-zero member dates. Launchpad rejects
	# binary packages containing those dates, so use the Debian changelog date.
	stamp=$$(date -d "$$(dpkg-parsechangelog -S Date)" +%s); \
		test "$$stamp" -ge 946684800; \
		find debian/galleoncore -type f -exec touch -d "@$$stamp" {} +

# Keep service activation an explicit choice of the logged-in user.
override_dh_installsystemduser:
