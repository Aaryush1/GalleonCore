#
# Qt Test runs test functions as private slots, so they must stay members.
# Fakes expose their state publicly so tests can inspect it.
---
InheritParentConfig: true
Checks: >
  -readability-convert-member-functions-to-static,
  -cppcoreguidelines-non-private-member-variables-in-classes
