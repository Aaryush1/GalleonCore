<Project Sdk="Microsoft.NET.Sdk">
  <!-- Desk lights helper. WinExe: no console window when Windows starts it at login. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DeskLights</RootNamespace>
    <AssemblyName>DeskLights</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\GalleonLink\GalleonLink.csproj" />
  </ItemGroup>
</Project>
